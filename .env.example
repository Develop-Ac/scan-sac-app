# ==============================================
# escaner-fiscal-app (frontend/PWA) - .env.example
# ==============================================
# Servidor estatico (server.mjs). Em dev, carregue com:
#   node --env-file=.env server.mjs
# Em producao (EasyPanel/Docker), defina estas variaveis no painel do app.

# Porta do servidor estatico do PWA.
PORT=8080

# URL publica do backend (escaner-fiscal-backend). NAO termine com "/".
# Quando definido, o server.mjs gera o /config.js a partir daqui
# (nao precisa editar public/config.js dentro da imagem).
# Vazio ("") = mesma origem do proprio front (util so se houver proxy reverso).
# Ex.: API_BASE=https://escaner-api.intranet.local
API_BASE=
